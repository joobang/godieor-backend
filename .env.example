# .env는 scripts/setup-local.mjs로 생성. 이 파일은 실제 비밀이 아니다.
POSTGRES_PASSWORD=replace-with-local-random-value
POSTGRES_PORT=55432
DATABASE_URL=postgresql://godieor:replace-with-local-random-value@127.0.0.1:55432/godieor_local
CURSOR_SIGNING_KEY=replace-with-at-least-32-random-bytes
API_HOST=127.0.0.1
PORT=3000
COLLECTION_SCHEDULE_ENABLED=false
GOOGLE_CLIENT_ID=
